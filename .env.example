# docker compose settings. Copy this file to `.env` and fill in the values.
#   cp .env.example .env

# ── DB ───────────────────────────────────────────────
POSTGRES_DB=aas
POSTGRES_USER=aas
# Important: you must change this. If left empty, the stack does not start
POSTGRES_PASSWORD=
# Optional: an app account that is not a superuser (db/10-app-user.sh), made once on an empty database. The site
#   installer (install.sh) fills both and keeps the superuser password above to itself. Empty = the app uses POSTGRES_USER
AAS_DB_USER=
AAS_DB_PASSWORD=

# ── Access control (docs/사용법.md §10-1) ──────────────────
# May be left empty — the default use case is an in-house setup where anyone may open and edit.
# Once set, only people holding a token get in.
#   Use letters, digits and symbols only — HTTP headers are ASCII by rule.
#   Separate multiple tokens with commas.
AAS_TOKEN=
# For reviewers — read-only
AAS_READONLY_TOKEN=

# Important: must be 1 for **several people in the company** to use it with no token set.
#    Without a token the program only listens on this computer (a safeguard).
#    1 means "open without a key", so other in-house computers can get in too.
#    Important: on a server exposed directly to the internet, do not set 1 — fill in AAS_TOKEN instead.
AAS_ALLOW_OPEN=1

# ── First-admin setup code (2026-10-02) ─────────────────
# With web login, a "Create the first admin" screen is open **while no account exists**.
# Important: on a server reachable from outside, anyone on the same network can click first and become admin —
#    and then the real operator is blocked with "an account already exists". So a setup code is required.
# If empty, the server generates a random one on every start and **prints it in the startup log** (docker compose logs).
# If set, that value is used — for deployments where reading the log is inconvenient.
AAS_SETUP_CODE=

# ── Public demo server (2026-10-04) ──────────────────────
# Turn on only when publishing it for anyone to try. Full procedure: docs/배포_호스팅.md
# The demo account is one account shared by many, but the workspace is **separate per login** —
# even with the same account, users cannot see each other's uploaded files.
DEMO_MODE=
# Demo account — if empty, the code defaults demo / 0629. admin is not used because it would be mistaken for an operator account (apps/api/src/demo.ts)
AAS_DEMO_LOGIN=
AAS_DEMO_PASSWORD=
# Deletes files a visitor has not touched for this many minutes. Files of signed-up users are never deleted.
# 0 = never delete — files of departed visitors just pile up
AAS_DEMO_RESET_MINUTES=60

# ── Workspace separation (2026-10-04) ────────────────────
# If empty, **the team sees the same files together** (default — the usual use of an in-house server).
# With private, each user sees only what they uploaded. Admins and API keys see everything.
# The demo (DEMO_MODE=on) always separates, regardless of this value.
# Important: files uploaded before turning this on have no owner and appear **read-only** to everyone.
AAS_WORKSPACE=

# Self sign-up. Important: **leave empty** on an in-house server — anyone could create accounts.
# Turned on automatically when DEMO_MODE=on (a demo server only makes sense with sign-up).
AAS_SIGNUP=
# Role for signed-up users: viewer (view only) / editor (edit). admin is not accepted — admins are promoted by an admin
AAS_SIGNUP_ROLE=editor
# Important: privacy policy URL. **If empty, no contact details are collected at all** —
#    so personal data is never gathered without stating how it is used.
#    If set, sign-up asks for name · company · email (required) and consent to collection and use (required) (docs/배포_호스팅.md §4).
AAS_PRIVACY_URL=

# Set only when a **web app** on another origin (in-house portal, MES screen) calls this API from the browser.
#   If empty, the browser blocks cross-origin requests (safest). The authoring UI is on the same port and does not need it,
#   and server-to-server calls (scripts, BaSyx) are unaffected. Multiple values: commas. `*` allows all (not recommended).
CORS_ORIGIN=

# ── Other ────────────────────────────────────────────
APP_PORT=8080
# Language of the server startup log — en for English. Empty = Korean. UI and server text language is chosen per viewer (Settings → Language)
AAS_LANG=
# Server address written into the manual PPT (read by scripts/make-beginner-pptx.py)
AAS_MANUAL_HOST=<서버주소>
# Collection (M8) — on only when OPC UA devices exist
COLLECT=off
# Automatic collection interval (seconds). Empty = manual ("Collect now") only
COLLECT_INTERVAL=
# Retention for collected values (days). Older values are deleted at startup and every hour.
# Empty or 0 = keep forever. A 5-second interval × 20 tags piles up 350k rows a day — 180 recommended for deployments
COLLECT_RETENTION_DAYS=180
# TimescaleDB only (the timescale/timescaledb image; nothing happens on plain PostgreSQL or the -oss image):
#   COLLECT_COMPRESS_AFTER_DAYS  compress collected values older than this many days — 15 to 22 times smaller in measurements (empty = 7, 0 = no)
#   COLLECT_ROLLUPS              1-minute and 1-hour aggregates collected_value_1m / _1h: avg, min, max, last, count
#                                per property (empty = on, off = none)
#   COLLECT_ROLLUP_MINUTE_DAYS   how long the 1-minute aggregate is kept (empty = 90, 0 = forever). The 1-hour one is kept
COLLECT_COMPRESS_AFTER_DAYS=
COLLECT_ROLLUPS=
COLLECT_ROLLUP_MINUTE_DAYS=
# Connections to PostgreSQL the server keeps open at most — a whole number from 1 to 1,000 (empty = 10).
#   Raise it for many people working at once; keep the sum over all servers below the database's max_connections (100)
PG_POOL_MAX=
# OPC UA security when collecting — taken from the AID (AID 1.1 securityDefinitions: Sign / SignAndEncrypt, policy,
#   user name). The collector's own certificate store. Empty = <AAS_DATA_DIR>/opcua-client-pki, else ./opcua-client-pki.
#   An unknown server certificate is refused and kept in <store>/rejected — move it to <store>/trusted/certs to trust it
OPCUA_CLIENT_PKI_DIR=
# first-use = accept a server certificate the first time it is seen. Empty = refuse until a person trusts it
OPCUA_CLIENT_TRUST=
# JSON file with user names and passwords by endpoint, for servers whose AID asks for a user name:
#   {"opc.tcp://10.0.0.5:4840": {"userName": "...", "password": "..."}}. Passwords never go into the AAS
OPCUA_CLIENT_CREDENTIALS=
# Outbound proxy for webhooks: http://[user:pass@]host:port. Outside names go through it unresolved (HTTP CONNECT,
#   TLS end to end); internal names (no dot, .local, .internal, .lan, .corp, .home.arpa) and private addresses go direct
INTEGRATION_PROXY=
# Targets that go direct even with a proxy (AAS_INTEGRATION_ALLOW syntax, comma separated)
INTEGRATION_NO_PROXY=
# Remote collectors (VEXPLOR Edge, docs/edge-contract.md). Empty = an admin switches it on in the 「원격 수집기」 screen
#   (off until then) · on = always on · off = always off, the screen cannot switch it
EDGE=

# ── OPC UA exposure (M6·M7) — serves values to upper-level apps (MES, SCADA) ──
#   When on, the authoring tool **becomes an OPC UA server**. N upper-level apps receive the collected values via subscriptions.
#   Secure by default (2026-10-14): Sign / SignAndEncrypt only, no anonymous session, users = the web accounts.
#   With no account yet the OPC UA server does not start — create the first admin first. docs/integration.md §9
#   Check: node scripts/opcua-browse.mjs opc.tcp://<server>:4840/UA/AAS
OPCUA_SERVER=off
# on = the old behaviour: no authentication, no encryption. Important: only on an isolated test network
OPCUA_ALLOW_INSECURE=
# OPC UA certificate store (server certificate, trusted and rejected client certificates).
#   Empty = <AAS_DATA_DIR>/opcua-pki, else ./opcua-pki. Trust a client in Settings → Integrations → OPC UA certificates
OPCUA_PKI_DIR=
# The standard OPC UA port is 4840
#   Important: but **equipment (PLCs) usually uses 4840 too.** When the "serving address" and the "equipment address"
#      match down to the port, people mix them up (there was an incident where it actually browsed itself).
#      Where confusion is likely, start it on another port such as OPCUA_PORT=4841.
OPCUA_PORT=4840
# Interval (seconds) for re-reading the address space. No reason for it to be shorter than the collection interval
OPCUA_REFRESH=5
# Address the server advertises. To connect from another PC, enter this machine's IP
OPCUA_HOST=
# Rule conflict ⑤: kosmo-first (KOSMO first) | preserve (keep standard template semanticId)
LINT_STANDARD_TERMS=kosmo-first
# File that changes conventions (values) without code changes. Usage §10-4
#   Important: an invalid value stops the server from starting — better than being silently ignored
# AAS_POLICY_FILE=/etc/aas/policy.json
# Upload AASX extraction limit (MB). Empty = default
AASX_MAX_TOTAL_MB=
# Template folder — .aasx files here are loaded automatically at startup and become the source for "Import from another file".
# The Docker setup uses ./templates (fixed in compose). For the single-user install, uncomment the line below to set the folder
# AAS_TEMPLATES_DIR=./templates

# ── MES / ERP / CMMS integration (docs/integration.md · docs/연동.md) ──────────────
# The event log and the pull feed (GET /integrations/events) always work. on = also run state detection,
# master-data notifications and pushing to subscriptions (webhook · MQTT). Always off in DEMO_MODE.
INTEGRATIONS=off
# Private-network or unencrypted (http · mqtt) targets a subscription may reach — comma list of CIDR, IP or host,
#   each optionally :port (also unblocks a listed port). Example: 10.20.0.0/16,mes.plant.local:8080
#   Important: empty = only public https / mqtts targets. Loopback and link-local are always refused.
AAS_INTEGRATION_ALLOW=
# Master key that seals webhook secrets and MQTT passwords — base64 of 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Important: required with PostgreSQL (this docker setup) to create subscriptions. Losing it means rotating every secret.
AAS_SECRET_KEY=
# Event log retention (days, by record time). Succeeded deliveries are kept 7 days, failed ones 30
INTEGRATION_RETENTION_DAYS=30
# Total deadline of one webhook attempt (milliseconds)
INTEGRATION_TIMEOUT_MS=10000
# Public address of this server (existing setting) — also used for event links, dataschema and document URLs in exports
# AAS_PUBLIC_URL=https://aas.plant.local
