# docker compose 설정. 이 파일을 `.env`로 복사해 값을 채우십시오.
#   cp .env.example .env

# ── DB ───────────────────────────────────────────────
POSTGRES_DB=aas
POSTGRES_USER=aas
# 🔴 반드시 바꾸십시오. 비워 두면 뜨지 않습니다
POSTGRES_PASSWORD=

# ── 접근 제어 (docs/사용법.md §10-1) ──────────────────
# 비워 두어도 됩니다 — 사내에서 누구나 열고 고쳐도 되는 경우가 기본 쓰임새입니다.
# 채우면 그때부터 토큰을 가진 사람만 들어옵니다.
#   영문·숫자·기호로 정하십시오 — HTTP 헤더는 ASCII가 원칙입니다.
#   여러 개를 줄 때는 쉼표로 구분합니다.
AAS_TOKEN=
# 검수자용 — 읽기만 됩니다
AAS_READONLY_TOKEN=

# 🔴 토큰을 비운 채 **사내 여러 사람이** 쓰려면 1이어야 합니다.
#    프로그램은 토큰이 없으면 스스로 이 컴퓨터에서만 문을 엽니다(안전장치).
#    1을 주면 "열쇠 없이 열겠다"는 뜻이 되어 사내 다른 컴퓨터에서도 들어옵니다.
#    🔴 인터넷에 직접 노출되는 서버라면 1로 두지 말고 AAS_TOKEN을 채우십시오.
AAS_ALLOW_OPEN=1

# ── 첫 관리자 설치 코드 (2026-10-02) ─────────────────
# 웹 로그인을 쓰면 **계정이 하나도 없는 동안** 「첫 관리자 만들기」 화면이 열립니다.
# 🔴 밖으로 열린 서버에서는 같은 망의 아무나 먼저 눌러 관리자가 될 수 있습니다 —
#    그러면 정작 운영자는 "이미 계정이 있습니다"로 막힙니다. 그래서 설치 코드를 묻습니다.
# 비워 두면 서버가 띄울 때마다 무작위로 만들어 **기동 로그에 찍습니다**(docker compose logs).
# 값을 적어 두면 그 값을 씁니다 — 로그를 보기 번거로운 배포에서 쓰십시오.
AAS_SETUP_CODE=

# ── 공개 체험 서버 (2026-10-04) ──────────────────────
# 누구나 눌러 볼 수 있게 공개해 둘 때만 켭니다. 자세한 절차는 docs/배포_호스팅.md
# 체험 계정은 여럿이 같이 쓰는 한 계정이지만, 작업 공간은 **로그인마다 따로**입니다 —
# 같은 계정으로 들어와도 서로가 올린 파일을 보지 못합니다.
DEMO_MODE=
AAS_DEMO_LOGIN=admin
AAS_DEMO_PASSWORD=1234
# 방문자가 이만큼(분) 손대지 않은 파일을 지웁니다. 가입한 사람의 파일은 지우지 않습니다.
# 0이면 안 지웁니다 — 떠난 방문자의 파일이 쌓이기만 합니다
AAS_DEMO_RESET_MINUTES=60

# ── 작업 공간 나누기 (2026-10-04) ────────────────────
# 비우면 **팀이 같은 파일을 같이 봅니다**(기본 — 사내 서버의 보통 쓰임새).
# private이면 저마다 자기가 올린 것만 봅니다. 관리자와 API 키는 전부 봅니다.
# 체험판(DEMO_MODE=on)은 이 값과 상관없이 언제나 나눕니다.
# 🔴 켜기 전에 올려 둔 파일은 주인이 없어 모두에게 **읽기 전용**으로 보입니다.
AAS_WORKSPACE=

# 스스로 가입하기. 🔴 사내망 서버에서는 **비워 두십시오** — 아무나 계정을 만듭니다.
# DEMO_MODE=on이면 자동으로 켜집니다(체험 서버는 가입이 있어야 뜻이 섭니다).
AAS_SIGNUP=
# 가입한 사람의 역할: viewer(보기만) / editor(고치기). admin은 받지 않습니다 — 관리자는 관리자가 올려 줍니다
AAS_SIGNUP_ROLE=editor
# 🔴 개인정보처리방침 주소. **비워 두면 연락처를 아예 받지 않습니다** —
#    어떻게 쓰는지 밝히지 않고 개인정보를 모으지 않기 위한 것입니다.
#    연락처를 받으려면 방침을 먼저 올리고 그 주소를 여기 적으십시오(docs/배포_호스팅.md §4).
AAS_PRIVACY_URL=

# 다른 주소의 **웹 앱**(사내 포털·MES 화면)이 브라우저에서 이 API를 부를 때만 적습니다.
#   비우면 교차 출처 요청을 브라우저가 막습니다(가장 안전). 저작 화면은 같은 포트라 필요 없고,
#   서버끼리 부르는 것(스크립트·BaSyx)도 무관합니다. 여러 개는 쉼표. `*`는 전부(권하지 않음).
CORS_ORIGIN=

# ── 그 밖 ────────────────────────────────────────────
APP_PORT=8080
# 매뉴얼 PPT에 적을 서버 주소 (scripts/make-beginner-pptx.py가 읽습니다)
AAS_MANUAL_HOST=<서버주소>
# 수집(M8) — OPC UA 장비가 있을 때만 on
COLLECT=off
# 자동 수집 주기(초). 비우면 수동(「지금 수집」)만
COLLECT_INTERVAL=
# 수집값 보존 기간(일). 그보다 오래된 값을 기동 때·한 시간마다 지웁니다.
# 비우거나 0이면 영구 보관. 5초 주기 × 태그 20개면 하루 35만 행이 쌓입니다 — 배포는 180 권장
COLLECT_RETENTION_DAYS=180

# ── OPC UA 노출(M6·M7) — 상위 앱(MES·SCADA)에 값을 내줍니다 ──
#   켜면 저작도구가 **OPC UA 서버가 됩니다**. 모아 온 값을 상위 앱 N개가 구독으로 받아 갑니다.
#   🔴 이 포트에는 인증이 없습니다(HTTP 토큰과 별개). 사내망 밖으로 열지 마십시오.
#   확인: node scripts/opcua-browse.mjs opc.tcp://<서버>:4840/UA/AAS
OPCUA_SERVER=off
# OPC UA 표준 포트는 4840입니다
#   🔴 그런데 **설비(PLC)도 대개 4840을 씁니다.** 「내주는 주소」와 「설비 주소」가 포트까지
#      같으면 사람이 헷갈립니다(실제로 자기 자신을 훑은 사고가 있었습니다).
#      헷갈릴 자리라면 OPCUA_PORT=4841처럼 다른 포트로 띄우십시오.
OPCUA_PORT=4840
# 주소공간을 다시 읽는 주기(초). 수집 주기보다 짧을 이유가 없습니다
OPCUA_REFRESH=5
# 서버가 광고할 주소. 다른 PC에서 붙으려면 이 기계의 IP를 적으십시오
OPCUA_HOST=
# 규정 충돌 ⑤: kosmo-first(KOSMO 우선) | preserve(표준 템플릿 semanticId 보존)
LINT_STANDARD_TERMS=kosmo-first
# 규약(값)을 코드 수정 없이 바꾸는 파일. 사용법 §10-4
#   🔴 틀린 값이 있으면 서버가 뜨지 않습니다 — 조용히 무시되는 것보다 낫습니다
# AAS_POLICY_FILE=/etc/aas/policy.json
# 업로드 AASX 해제 상한(MB). 비우면 기본값
AASX_MAX_TOTAL_MB=
# 템플릿 폴더 — 여기 둔 .aasx는 기동 때 자동으로 올라가 「다른 파일에서 가져오기」의 출처가 됩니다.
# Docker 구성은 ./templates 를 씁니다(compose에 고정). 혼자 쓰는 설치판은 아래 줄을 풀어 폴더를 지정
# AAS_TEMPLATES_DIR=./templates
